# ============================================================
#  Ratflix stack - template (copy to .env and fill in)
# ============================================================

# --- System ---
PUID=1000
PGID=1000
TZ=Europe/Paris

# --- Media paths (mounted at the same path inside containers) ---
MEDIA_PATH=/mnt/media
DATA_PATH=/mnt/data
DOWNLOADS_PATH=/mnt/data/downloads

# --- Local network ---
LAN_SUBNET=192.168.1.0/24
SERVER_IP=192.168.1.10

# --- Domains (Caddy) ---
JELLYFIN_DOMAIN=jellyfin.example.com
JELLYSEERR_DOMAIN=jellyseerr.example.com

# --- VPN (Gluetun) ---
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=changeme
SERVER_COUNTRIES=Switzerland
# Only used when VPN_TYPE=openvpn
OPENVPN_USER=changeme
OPENVPN_PASSWORD=changeme

# --- Gluetun control server (shared with Rustatio) ---
GLUETUN_API_KEY=changeme # openssl rand -base64 16

# --- Rustatio ---
RUSTATIO_AUTH_TOKEN=changeme # openssl rand -hex 32
